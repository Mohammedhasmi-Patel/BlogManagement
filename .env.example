# ==========================================
# Application Environment Variables (.env)
# Do NOT commit your actual .env file with secrets to Git!
# ==========================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# Database Connection String (PostgreSQL / Neon DB)
ConnectionStrings__DefaultConnection=Host=ep-dry-fog-a8712p5i-pooler.us-east-2.aws.neon.tech;Database=blog-management;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;

# JWT Configuration
JwtConfiguration__SecretKey=YOUR_MINIMUM_32_CHAR_SECRET_KEY_HERE
JwtConfiguration__Audience=BlogManagementFrontend
JwtConfiguration__Issuer=BlogManagementBackend
JwtConfiguration__JwtExpireInMinutes=60

# Application Settings
AppSettings__BaseUrl=https://your-api-domain.com

# Allowed CORS Origins (Frontend URLs)
AllowedOrigins__0=https://your-frontend.vercel.app
AllowedOrigins__1=http://localhost:3000
